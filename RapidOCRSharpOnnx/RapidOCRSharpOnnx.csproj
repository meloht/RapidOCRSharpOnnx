<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>RapidOCRSharpOnnx</Title>
		<PackageProjectUrl>https://github.com/meloht/RapidOCRSharpOnnx</PackageProjectUrl>
		<RepositoryUrl>https://github.com/meloht/RapidOCRSharpOnnx</RepositoryUrl>
		<PackageTags>ocr;paddle-ocr;paddleocr;PP-OCRv6;PP-OCRv5;PP-OCRv4;csharp;onnx;onnx-runtime;cross-platform;cpu;cuda;gpu;tensorrt;coreml;directml;openvino;computer-vision;text-recognition;text-detection</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>meloht</Authors>
		<Version>1.4.0</Version>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Copyright>Copyright © meloht</Copyright>
		<PackageReleaseNotes>RapidOCRSharpOnnx 1.4.0 Upgrade from OpenCvSharp4 to OpenCvSharp5, Microsoft.ML.OnnxRuntime.Managed 1.29.0 to 1.30.0</PackageReleaseNotes>
		<Description>a high performance, cross-platform PaddleOCR C# inference library base on OpenCV and ONNX Runtime</Description>
		<PackageIcon>RapidOCRSharpOnnx_256.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\imgs\RapidOCRSharpOnnx_256.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<EmbeddedResource Include="Assets\Fonts\*.*" />
		<EmbeddedResource Include="Assets\dict\*.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" />
		<PackageReference Include="OpenCvSharp5" Version="5.0.0.20261107" />
		<PackageReference Include="SkiaSharp" Version="4.155.0" />
	</ItemGroup>

	

</Project>
